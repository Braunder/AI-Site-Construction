# --- LLM (OpenAI-совместимый API) ---
# Для OpenAI: https://api.openai.com/v1 + ваш ключ + модель gpt-4o / gpt-4o-mini
# Для локальной LLM (llama.cpp / LM Studio): http://127.0.0.1:8080/v1, ключ любой
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local
LLM_MODEL=Qwen3.5-9B.Q5_K_M.gguf
# Таймаут одного запроса к LLM, секунд (локальные модели медленные — не занижайте)
LLM_TIMEOUT=600
# Число повторных попыток при сбоях/невалидном HTML
LLM_MAX_RETRIES=2
# Лимит токенов ответа
LLM_MAX_TOKENS=16000

# --- Приложение ---
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Секрет для сессий админки — в production обязательно заменить
SECRET_KEY=change-me-in-production
# Разрешённые origins для CORS, через запятую
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
